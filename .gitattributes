# Normalize line endings so a Windows checkout gets the right ones.
* text=auto

# Windows scripts want CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf

# Keep these LF regardless of platform
*.py  text eol=lf
*.js  text eol=lf
*.json text eol=lf
*.html text eol=lf
*.md  text eol=lf

# Binary assets
*.exe binary
*.png binary
